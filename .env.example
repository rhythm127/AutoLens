# AutoLens Environment Configuration Example
# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file with actual credentials or secrets to git.

# Application Environment Settings
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000

# CORS / Allowed Origins (for the upcoming React frontend development server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret Key Placeholder (use a strong random value for production)
SECRET_KEY=change-me-to-a-secure-random-string-in-production

# RAG Vector Store Settings
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Chat: OpenRouter first, Gemini next, local Ollama last; blank keys are supported.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=llama3.2

# Relative to the backend working directory; SQLite is separate from ChromaDB.
DATABASE_PATH=./data/autolens.sqlite3
